---
import Base from '../layouts/Base.astro';
---
<Base title="找不到頁面" description="這個頁面不存在。" noindex>
  <section class="container nf">
    <h1>找不到這個頁面</h1>
    <p>網址可能打錯了，或頁面已經移走。</p>
    <a class="back" href="/">回首頁</a>
  </section>
</Base>

<style>
  .nf { padding-block: 96px; }
  h1 { font-size: var(--fs-2xl); margin-bottom: 12px; }
  p { color: var(--fg-muted); }
  .back { display: inline-block; margin-top: 24px; font-weight: 700; }
</style>
